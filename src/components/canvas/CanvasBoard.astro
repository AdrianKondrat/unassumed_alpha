---
import { CANVAS_BLOCKS } from "@/lib/services/canvas-draft";
import type { CanvasClaim } from "@/types";
import ClaimCard from "./ClaimCard.astro";

interface Props {
  claims: CanvasClaim[];
}

const { claims } = Astro.props;
const byBlock = new Map(
  CANVAS_BLOCKS.map((block) => [
    block.key,
    claims.filter((claim) => claim.block === block.key).sort((a, b) => a.position - b.position),
  ]),
);
---

<ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  {CANVAS_BLOCKS.map((block, index) => {
    const blockClaims = byBlock.get(block.key) ?? [];
    return (
      <li class="card-flat flex flex-col gap-3 p-5">
        <div>
          <div class="font-mono text-xs font-bold tracking-[0.16em] text-ink-mute">
            {String(index + 1).padStart(2, "0")}
          </div>
          <h3 class="disp mt-1 text-2xl">{block.label}</h3>
          <p class="mono-note mt-1">{block.hint}</p>
        </div>
        {blockClaims.length > 0 ? (
          <ul class="mt-1 flex flex-col gap-4" aria-label={`${block.label} claims`}>
            {blockClaims.map((claim) => (
              <ClaimCard claim={claim} />
            ))}
          </ul>
        ) : (
          <p class="text-sm text-ink-soft">Nothing here yet.</p>
        )}
      </li>
    );
  })}
</ol>
