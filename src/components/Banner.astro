---
type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;
---

<div
  class:list={[
    "border-b-2 px-4 py-3 text-center text-sm",
    variant === "error" && "border-red-text bg-[#fdecea] text-[#7a1912]",
    variant === "warning" && "border-ink bg-yellow text-ink",
    variant === "info" && "border-ink bg-paper-ui text-ink",
  ]}
  role={variant === "error" ? "alert" : "status"}
>
  <slot />
</div>
