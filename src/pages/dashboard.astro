---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { getCurrentWorkspace } from "@/lib/services/workspace";
import { getCurrentProject } from "@/lib/services/project";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const workspace = supabase ? await getCurrentWorkspace(supabase) : null;
const project = supabase && workspace ? await getCurrentProject(supabase) : null;
const passwordChanged = Astro.url.searchParams.get("passwordChanged") === "1";

const stages = [
  {
    n: "01",
    name: "Scribble",
    body: "Rough notes become a canvas of claims you can argue with.",
    href: project ? "/project" : "/project/new",
    cta: project ? "Open your canvas" : "Start your project",
  },
  { n: "02", name: "Assumption", body: "Claims become named, testable assumptions." },
  { n: "03", name: "Rehearsal", body: "Practise the interview. We score your questions, never your idea." },
];
---

<Layout title="Home" current="dashboard">
  <div class="mx-auto w-[min(1180px,100%-32px)] py-10 sm:py-14">
    {passwordChanged && (
      <p role="status" class="notice notice-ok mb-8 max-w-xl">
        Password updated. Other devices have been signed out.
      </p>
    )}

    <div class="eyebrow mb-5">
      <i></i> Your workspace
    </div>
    {workspace ? (
      <>
        <h1 class="disp text-[clamp(2.4rem,6vw,4.4rem)]">{workspace.name}</h1>
        <p class="mono-note mt-3">{user?.email}</p>
        <a href={project ? "/project" : "/project/new"} class="btn btn-yellow mt-8">
          {project ? "Open your canvas" : "Create your project"}
        </a>
      </>
    ) : (
      <div role="alert" class="notice notice-error max-w-xl">
        <strong>We couldn't load your workspace.</strong> Your account is fine, but something went wrong on our side.
        Refresh the page, and if it keeps happening contact support.
      </div>
    )}

    <section class="mt-14" aria-labelledby="journey">
      <h2 id="journey" class="slabel mb-6">
        The loop
      </h2>
      <ol class="grid gap-6 md:grid-cols-3">
        {stages.map((s) => (
          <li class="card-flat p-6">
            <div class="font-mono text-xs font-bold tracking-[0.16em] text-ink-mute">{s.n}</div>
            <h3 class="disp mt-2 text-3xl">{s.name}</h3>
            <p class="mt-3 text-ink-soft">{s.body}</p>
            {s.href ? (
              <a href={s.href} class="link mt-5 inline-block">
                {s.cta}
              </a>
            ) : (
              <span class="tag tag-open mt-5">Coming next</span>
            )}
          </li>
        ))}
      </ol>
    </section>
  </div>
</Layout>
