---
import AuthShell from "@/components/auth/AuthShell.astro";

const params = Astro.url.searchParams;
const unverified = params.get("unverified") === "1";
const sent = params.get("sent") === "1";
const error = params.get("error");
const pendingEmail = Astro.cookies.get("pending_email")?.value ?? "";
---

<AuthShell
  title="Check your email"
  lede={
    unverified
      ? "That account hasn't been verified yet. Open the link we emailed you, or request a new one below."
      : "We've sent a verification link. Open it to activate your account and you'll land in your workspace."
  }
>
  {error && (
    <p role="alert" class="notice notice-error mb-5 text-sm">
      {error}
    </p>
  )}
  {sent && (
    <p role="status" class="notice notice-ok mb-5 text-sm">
      If an account exists for that address, a new link is on its way. It can take a minute, and you can ask again after
      60 seconds.
    </p>
  )}
  <form method="POST" action="/api/auth/resend" class="space-y-4">
    <div>
      <label for="email" class="label">
        Email
      </label>
      <input
        id="email"
        name="email"
        type="email"
        required
        autocomplete="email"
        value={pendingEmail}
        placeholder="you@your-next-thing.com"
        class="input"
      />
    </div>
    <button type="submit" class="btn btn-ghost w-full">
      Send the link again
    </button>
  </form>
  <p class="mt-6 text-center text-sm text-ink-soft">
    Wrong address?{" "}
    <a href="/auth/signup" class="link">
      Start again
    </a>{" "}
    or{" "}
    <a href="/auth/signin" class="link">
      sign in
    </a>
  </p>
</AuthShell>
