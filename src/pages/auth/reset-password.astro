---
import AuthShell from "@/components/auth/AuthShell.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm";

const error = Astro.url.searchParams.get("error");
---

<AuthShell title="Choose a new password" lede="You're signed in with your reset link. Set a new password to finish.">
  <ResetPasswordForm serverError={error} client:load />
</AuthShell>
