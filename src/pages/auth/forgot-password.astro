---
import AuthShell from "@/components/auth/AuthShell.astro";
import ForgotPasswordForm from "@/components/auth/ForgotPasswordForm";

const params = Astro.url.searchParams;
const sent = params.get("sent") === "1";
const error = params.get("error");
---

<AuthShell
  title="Reset your password"
  lede={sent ? undefined : "Enter your email and we'll send you a link to choose a new password."}
>
  {sent ? (
    <div class="space-y-5">
      <p role="status" class="notice notice-ok text-sm">
        If an account exists for that address, a reset link is on its way. It can take a minute to arrive.
      </p>
      <a href="/auth/signin" class="btn btn-ghost w-full">
        Back to sign in
      </a>
    </div>
  ) : (
    <>
      <ForgotPasswordForm serverError={error} client:load />
      <p class="mt-6 text-center text-sm text-ink-soft">
        Remembered it?{" "}
        <a href="/auth/signin" class="link">
          Sign in
        </a>
      </p>
    </>
  )}
</AuthShell>
