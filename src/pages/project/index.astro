---
import Layout from "@/layouts/Layout.astro";
import CanvasBoard from "@/components/canvas/CanvasBoard.astro";
import { createClient } from "@/lib/supabase";
import { getCurrentProject, listClaims } from "@/lib/services/project";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const project = supabase ? await getCurrentProject(supabase) : null;
if (!supabase || !project) return Astro.redirect("/project/new");

const claims = await listClaims(supabase, project.id);
const drafted = claims.length > 0;

// Only known codes are rendered; the query string is never echoed back.
const DRAFT_ERRORS: Record<string, string> = {
  ai_failed: "We couldn't get a draft from the AI just now. Your notes are safe. Try again in a moment.",
  invalid_output: "The AI's draft didn't come back in a usable shape. Your notes are safe. Try again.",
  not_found: "We couldn't find your project. Refresh the page.",
};
const draftError = DRAFT_ERRORS[Astro.url.searchParams.get("draftError") ?? ""];
---

<Layout title="Your project" current="project">
  <div class="mx-auto w-[min(1180px,100%-32px)] py-10 sm:py-14">
    <div class="eyebrow mb-5">
      <i></i> Scribble
    </div>
    <h1 class="disp text-[clamp(2.2rem,5.5vw,3.8rem)]">Your canvas</h1>

    <details class="card-flat mt-6 max-w-3xl p-4">
      <summary class="cursor-pointer text-[15px] font-bold">Your notes</summary>
      <p class="mt-3 whitespace-pre-wrap text-ink-soft">{project.brief}</p>
    </details>

    {drafted ? (
      <>
        <p class="notice notice-info mt-6 max-w-3xl">
          <strong>Treat this as a first draft to argue with.</strong> Claims marked{" "}
          <span class="tag tag-yellow">AI draft</span> were written by the AI from your notes. They are guesses, not
          facts.
        </p>
        <div class="mt-8">
          <CanvasBoard claims={claims} />
        </div>
      </>
    ) : (
      <section class="card mt-8 max-w-3xl p-6 sm:p-8" aria-labelledby="draft-heading">
        <h2 id="draft-heading" class="disp text-3xl">
          Draft my canvas
        </h2>
        <p class="mt-3 text-ink-soft">
          The AI will turn your notes into nine blocks of short claims. Each one is marked as an AI draft so you can see
          what you have and haven't checked yourself.
        </p>
        {draftError && (
          <p role="alert" class="notice notice-error mt-5">
            {draftError}
          </p>
        )}
        <form method="POST" action="/api/projects/draft" class="mt-6" data-pending>
          <div class="flex flex-wrap items-center gap-4">
            <button type="submit" class="btn btn-yellow">
              {draftError ? "Try again" : "Draft my canvas"}
            </button>
            <p data-pending-status hidden role="status" class="mono-note">
              Drafting your canvas. This can take up to 30 seconds. Please keep this page open.
            </p>
          </div>
        </form>
      </section>
    )}
  </div>
</Layout>

<script>
  import "@/scripts/pending-forms";
</script>
