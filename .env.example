SUPABASE_URL=###
# Legacy anon / publishable key — used by Astro SSR (@supabase/ssr) as SUPABASE_KEY.
SUPABASE_KEY=###
SUPABASE_PUBLISHABLE_KEY=###
# Server-only secret / service_role key. Never commit it or expose it to the browser.
SUPABASE_SECRET_KEY=###
# Alias for existing app code (same value as SUPABASE_SECRET_KEY).
SUPABASE_SERVICE_ROLE_KEY=###
# JWT verification for @supabase/server (Dashboard -> Settings -> API -> JWT Keys / JWKS URL).
SUPABASE_JWKS_URL=###
OPENROUTER_API_KEY=###
# Optional: override the OpenRouter API base URL (defaults to https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=###
